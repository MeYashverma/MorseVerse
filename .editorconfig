# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{xml,json}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_style = space
indent_size = 2

[*.properties]
charset = utf-8

[*gradle*]
indent_style = space
indent_size = 4

# IntelliJ specific
[*.iml]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab
