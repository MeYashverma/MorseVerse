<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/morse_cyan</item>
        <item name="colorPrimaryVariant">@color/morse_cyan_dark</item>
        <item name="colorOnPrimary">@android:color/black</item>

        <item name="colorSecondary">@color/morse_amber</item>
        <item name="colorSecondaryVariant">@color/morse_amber_dark</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <item name="colorTertiary">@color/morse_violet</item>
        <item name="colorOnTertiary">@android:color/black</item>

        <item name="colorError">@color/morse_red</item>
        <item name="colorOnError">@android:color/white</item>

        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>

        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dark theme (default) -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorOutline">@color/dark_outline</item>
    </style>

    <!-- Light theme -->
    <style name="AppTheme.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/light_on_surface_variant</item>
        <item name="colorOutline">@color/light_outline</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- AMOLED theme -->
    <style name="AppTheme.Amoled" parent="AppTheme.Dark">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
    </style>

    <!-- Button styles -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppButton.Primary">
        <item name="backgroundTint">@color/morse_cyan</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="AppButton.Secondary">
        <item name="backgroundTint">@color/morse_amber</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="AppButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/morse_cyan</item>
        <item name="android:textColor">@color/morse_cyan</item>
    </style>

    <!-- Card styles -->
    <style name="AppCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">@color/dark_surface_variant</item>
    </style>

    <!-- Text styles -->
    <style name="AppText.DisplayLarge">
        <item name="android:textSize">@dimen/text_5xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_on_background</item>
    </style>

    <style name="AppText.HeadlineMedium">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_on_background</item>
    </style>

    <style name="AppText.TitleMedium">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="AppText.BodyLarge">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="AppText.LabelSmall">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/dark_on_surface_variant</item>
    </style>

    <!-- Morse code text style -->
    <style name="AppText.MorseCode">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/morse_cyan</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
